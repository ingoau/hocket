{
  "name": "hocket-desktop",
  "productName": "Hocket",
  "version": "0.1.0",
  "description": "Hocket desktop: a Navidrome client with multi-device playback.",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "out/main/index.cjs",
  "author": "Hocket contributors",
  "homepage": "https://github.com/ingoau/hocket",
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:types": "node scripts/gen.mjs --types-only",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "node scripts/build.mjs && electron-builder --config electron-builder.yml",
    "dist:dir": "node scripts/build.mjs && electron-builder --config electron-builder.yml --dir",
    "start": "electron ."
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kawarp/core": "^1.2.2",
    "@tanstack/react-virtual": "^3.13.12",
    "lucide-react": "^1.47.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.36.0",
    "@napi-rs/cli": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
