<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" xmlns:tools="http://schemas.android.com/tools" />

    <application
        android:name="app.hocket.HocketApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hocket"
        android:usesCleartextTraffic="true">
        <!-- Cleartext stays allowed app-wide: the server address is the user's own (often a LAN
             Navidrome on plain http) and a network security config cannot be scoped to a host that
             is only known at runtime. The setup screen warns prominently for http:// addresses,
             ExoPlayer never follows an https->http redirect (ExoBackend), and the core only attempts
             the native-API password login over https or loopback. See android/README.md. -->

        <!-- Android Auto lists media apps that declare this; the browse tree is PlaybackService's. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name="app.hocket.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Hocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
