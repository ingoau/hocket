<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Reading the SSID (for per-network transcoding profiles) needs location on Android 8.1+. Optional: without it the network id falls back to the transport type. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Who may send media keys to the media button receiver below: this app only (signature). The
         system's sends pass any permission check, and the session's own media button PendingIntent
         carries this app's identity. -->
    <permission
        android:name="${applicationId}.permission.MEDIA_BUTTON"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.MEDIA_BUTTON" />

    <application>
        <service
            android:name="app.hocket.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Publishes the other Connect devices to MediaRouter2 (system output switcher, the media
             controls' output chip). Only the system can call into it (MediaRoute2ProviderService
             checks the caller); the class needs API 30 and older systems never bind it. -->
        <service
            android:name="app.hocket.playback.ConnectRouteProvider"
            android:exported="true"
            tools:targetApi="30">
            <intent-filter>
                <action android:name="android.media.MediaRoute2ProviderService" />
            </intent-filter>
        </service>
        <!-- Cover art for the apps browsing the library (Auto, Wear, MediaBrowsers): they cannot read
             the core's cache files. Exported because a controller opens the URI itself, but
             ArtworkProvider only serves callers the session accepted as controllers, read-only. -->
        <provider
            android:name="app.hocket.playback.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />
        <!-- The Pebble watchapp's messages (PebbleKit 2). Exported for the Pebble app; PebbleKit itself
             ignores callers other than the selected Pebble app. -->
        <service
            android:name="app.hocket.playback.pebble.PebbleListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>
        <!-- The bundled watchapp, handed to the Pebble app to install (read grant per intent only). -->
        <provider
            android:name="app.hocket.playback.pebble.PebbleFileProvider"
            android:authorities="${applicationId}.pebble"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pebble_paths" />
        </provider>
        <!-- Playback resumption: a play key while the service is stopped (a headset, the system's
             last media button receiver) reaches Media3's receiver (HocketMediaButtonReceiver: not
             when there is nothing to resume), which FGS-starts the service only for PLAY /
             PLAY_PAUSE / HEADSETHOOK; the session then resumes through onPlaybackResumption, and
             the service holds the foreground meanwhile (ForegroundHold). The widget's play button
             starts the service the same way, from its own private receiver. Declaring it is also what makes Media3 offer System UI its
             recent root (the resumption card). Guarded by the signature permission above, so no
             other app can start playback with a key event (the legacy
             androidx.media.session.MediaButtonReceiver, exported unguarded, once let any app). -->
        <receiver
            android:name="app.hocket.playback.HocketMediaButtonReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.MEDIA_BUTTON">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- The now-playing home-screen widget. Exported for the launcher's APPWIDGET_UPDATE (a
             forged one only redraws the stored state); its buttons go to the private receiver. -->
        <receiver
            android:name="app.hocket.playback.NowPlayingWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>
        <receiver
            android:name="app.hocket.playback.WidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
